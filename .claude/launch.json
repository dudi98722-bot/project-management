{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8793",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8793
    },
    {
      "name": "therapy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "therapy-crm",
        "run",
        "dev-local"
      ],
      "port": 3720
    },
    {
      "name": "stam-shter",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "stam-shter",
        "run",
        "dev-local"
      ],
      "port": 3620
    }
  ]
}